  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@tattoo-ai/config": "workspace:*",
    "@tattoo-ai/core": "workspace:*"
  }
}
